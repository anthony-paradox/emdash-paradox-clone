---
import Base from "../layouts/Base.astro";
import ContentHero from "../components/site/templates/ContentHero.astro";
import { HUBSPOT } from "../data/live-site";
import "../styles/paradox/content.css";
---

<Base title="Discovery Call" description="Book a Paradox Marketing discovery call.">
	<ContentHero
		title="Discovery call"
		intro="We’ll map how your website, ads, and CRM connect today."
		kicker="Book time"
	/>
	<section class="content-section">
		<div class="pdx-content-container">
			<iframe
				title="Paradox discovery call"
				src={HUBSPOT.meetingUrl}
				style="width:100%;min-height:720px;border:0;border-radius:12px"
			></iframe>
		</div>
	</section>
</Base>
