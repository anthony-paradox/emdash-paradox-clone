---
interface Metric {
	value: string;
	label: string;
}

interface Props {
	title?: string;
	intro?: string;
	metrics: Metric[];
}

const {
	title = "Marketing that connects to the numbers",
	intro = "We judge the system by what it changes for the business.",
	metrics,
} = Astro.props;
---

<section class="content-section content-metrics">
	<div class="pdx-content-container">
		<div class="content-section__heading">
			<p class="content-kicker">The impact</p>
			<h2>{title}</h2>
			<p>{intro}</p>
		</div>
		<div class="content-metrics__grid">
			{
				metrics.map((metric) => (
					<div class="content-metric">
						<strong>{metric.value}</strong>
						<span>{metric.label}</span>
					</div>
				))
			}
		</div>
	</div>
</section>
